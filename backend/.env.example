# --- LLM provider (Anthropic Claude) ---
# Get a key at https://console.anthropic.com/
LLM_API_KEY=

# --- Search provider (Google Custom Search JSON API) ---
# Get a key at https://developers.google.com/custom-search/v1/overview
SEARCH_API_KEY=
# Create a Programmable Search Engine at https://programmablesearchengine.google.com/
# and set it to "search the entire web" to get this ID.
SEARCH_ENGINE_ID=

# --- Database ---
# Path to the SQLite file. Defaults to ./research.db if unset.
DATABASE_URL=sqlite:///./research.db

# --- CORS ---
# Comma-separated list of origins allowed to call this API.
FRONTEND_ORIGIN=http://localhost:5173
